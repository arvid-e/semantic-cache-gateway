# Semantic Cache Gateway — environment contract (platform-foundation)
#
# This file is the documented source of truth for runtime env vars. It mirrors
# src/platform/config/schema.ts. Copy to `.env` for local dev and fill in values.
# Required vars have no default and fail startup when missing.
#
# The integration suite loads `.env` into the environment (vitest.setup.ts), so
# the same file that runs the gateway locally also runs `npm run test:integration`
# against `docker compose up -d postgres redis`. An exported shell variable still
# wins over the file. The unit suite reads neither.

# --- HTTP ---
# Port the gateway listens on. Optional.
HTTP_PORT=3000

# Log verbosity. Optional. One of: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Runtime mode. Optional. One of: development | test | production
NODE_ENV=development

# --- PostgreSQL (pgvector) ---
# Connection string. REQUIRED. Sensitive — never logged or echoed in errors.
POSTGRES_URL=postgres://user:password@localhost:5432/gateway

# Max connections in the pool. Optional.
POSTGRES_POOL_MAX=10

# --- Redis ---
# Connection string. REQUIRED. Sensitive — never logged or echoed in errors.
REDIS_URL=redis://localhost:6379

# --- Ollama (local embeddings) ---
# Base URL. REQUIRED.
OLLAMA_URL=http://localhost:11434

# --- Auth / tenancy / credentials (auth-tenancy-credentials) ---
# A SEPARATE, validated env segment owned by the auth module (see
# src/modules/auth/config.ts). Every value here is secret material — never
# logged or echoed. All REQUIRED once the auth module is enabled.
#
# AES-256-GCM keyring: comma-separated `version:base64key` entries; each key must
# base64-decode to exactly 32 bytes. Multiple versions allow key rotation.
AUTH_ENCRYPTION_KEYS=1:<base64-encoded-32-byte-key>
# Which keyring version encrypts new credentials. Must exist in AUTH_ENCRYPTION_KEYS.
AUTH_ACTIVE_KEY_VERSION=1
# HMAC pepper for gateway-key hashing. Base64, must decode to >= 32 bytes.
AUTH_GATEWAY_KEY_PEPPER=<base64-encoded-32-byte-secret>
# Bearer token authorizing the admin/provisioning API. Min 16 chars.
AUTH_ADMIN_TOKEN=<admin-api-token>

# --- Gateway / provider routing (gateway-provider-routing) ---
# A SEPARATE, validated env segment owned by the gateway module (see
# src/modules/gateway/config.ts). Every value here is OPTIONAL — each has a
# correct default in code, so the module boots on an empty gateway environment
# and only an *invalid* value fails startup.
#
# NOTE: no provider API key belongs here. The gateway holds no provider account;
# keys are per tenant (BYOK), supplied per request via the `x-provider-key`
# header or stored encrypted by the auth module.

# Upper bound on a single provider call before it is treated as a timeout (ms).
PROVIDER_TIMEOUT_MS=30000

# Sent where a provider requires a max-tokens value the client omitted.
# Anthropic requires one; OpenAI and Ollama do not.
PROVIDER_DEFAULT_MAX_TOKENS=1024

# OpenAI API root. Override for a proxy, a gateway, or a test stub.
# Sensitive: may carry proxy userinfo, so it is never echoed in an error.
# Must NOT embed credentials (`https://user:pass@host` is rejected at startup).
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic API root. Same rules as OPENAI_BASE_URL.
ANTHROPIC_BASE_URL=https://api.anthropic.com

# Value for the `anthropic-version` request header. Must be a dated release.
# Pinned in code; override only to roll forward to a newer dated release.
ANTHROPIC_VERSION=2023-06-01

# Ollama's base URL is NOT re-read here — the gateway reuses the foundation's
# OLLAMA_URL above.

# --- Dual-layer caching (dual-layer-caching) ---
# A SEPARATE, validated env segment owned by the cache module (see
# src/modules/cache/config.ts). Nothing here is secret. All REQUIRED with no
# defaults: a default threshold would be a silent product decision.

# Minimum cosine similarity for a stored entry to be served. Higher is stricter.
CACHE_SIMILARITY_THRESHOLD=0.83

# At or above this similarity to the last AI response, the latest user message
# is context-dependent and must pass verification.
CACHE_TOPIC_SHIFT_THRESHOLD=0.6

# Minimum alignment between a candidate's originating context and this one.
CACHE_VERIFICATION_THRESHOLD=0.75

# Whole seconds: Redis `EX`, and an `expires_at` every read filters on.
CACHE_EXACT_TTL_SECONDS=3600
CACHE_SEMANTIC_TTL_SECONDS=86400

# Must be pulled locally and emit the 768 dims the schema declares.
CACHE_EMBEDDING_MODEL=nomic-embed-text
